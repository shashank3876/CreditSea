# Local MongoDB connection for development. Use a replica set for payment transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/creditsea

# Replace with a unique, randomly generated value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional when the web app and API are on different origins.
WEB_ORIGIN=http://localhost:3000

# Required only when manually creating the evaluation accounts.
SEED_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ALLOW_DEMO_SEED=false

# Replit App Storage provides this private path in the workspace.
PRIVATE_OBJECT_DIR=replace-with-your-private-object-storage-directory
