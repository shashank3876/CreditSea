# Use a reachable MongoDB replica set (for example, an Atlas cluster).
# Transactions require a replica set; replace this placeholder with your own URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?appName=CreditSea-LMS

# Replace with a unique, randomly generated value of at least 32 characters.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-chars

# Optional when the web app and API are on different origins.
WEB_ORIGIN=http://localhost:3000

# Local `next dev` only: proxy /api from the web app to the API server.
# API_PROXY_TARGET=http://127.0.0.1:8080

# Required only when manually creating the evaluation accounts (12–128 characters).
SEED_PASSWORD=replace-with-unique-seed-password
ALLOW_DEMO_SEED=false

# ---------------------------------------------------------------------------
# Private salary-slip storage — choose ONE backend
# ---------------------------------------------------------------------------
# MongoDB stores a durable objectKey like /objects/uploads/<uuid>.
# Do NOT persist temporary presigned URLs in MongoDB (they expire).

# AWS S3 (recommended for production / Elastic Beanstalk / ECS / EC2):
AWS_REGION=ap-south-1
AWS_S3_BUCKET=creditsea-salary-slips-private
# Prefer an IAM instance/task role in AWS. For local testing only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# Local filesystem (development only):
# PRIVATE_OBJECT_DIR=./.private-objects
# STORAGE_DRIVER=fs
